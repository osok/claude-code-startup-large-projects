# Project-generated documents (per-project, not part of template)
requirement-docs/*.md
!requirement-docs/_sample-requirements.md
!requirement-docs/README.md
design-docs/*.md
developer-docs/*.md
project-docs/*.md
project-docs/*.log
project-docs/adrs/*.md
!project-docs/adrs/_template-adr.md
project-docs/schemas/*.md
!project-docs/schemas/_template-schema.md

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Temporary files
*.tmp
*.temp

# Python bytecode cache (hook scripts compile on first run)
__pycache__/
*.pyc

# Environment files with secrets
.env
.env.local
.env.*.local

# Keep example env files
!.env-example
!.env.example

# Local scripts
run-chrome.sh

# ---------------------------------------------------------------------------
# Local-only allowlist for the requirements-gate hook (this file only exists
# in this repo). The hook reads .claude/hooks/requirements-gate-allowlist.txt
# at runtime — one path prefix per line — and treats those paths as allowed
# in addition to its built-in defaults.
#
# This repo IS the framework template, so almost every edit hits the gate.
# We populate the local allowlist with everything we need to maintain the
# framework. Sub-projects scaffolded from this template will NOT inherit the
# allowlist file, so their gate keeps its full restrictive behavior — they
# will be warned (blocked) before edits, exactly as designed.
# ---------------------------------------------------------------------------
.claude/hooks/requirements-gate-allowlist.txt
